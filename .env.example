# SubFlow Environment Configuration

# Database
DATABASE_URL="postgresql://subflow:subflow@localhost:5432/subflow_db?schema=public"
POSTGRES_USER=subflow
POSTGRES_PASSWORD=subflow
POSTGRES_DB=subflow_db
POSTGRES_PORT=5432

# Backend API
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Authentication & Security
JWT_SECRET=super-secret-subflow-jwt-token-key-2026-min-32-chars
COOKIE_SECRET=super-secret-subflow-cookie-key-2026-min-32-chars

# Billing Worker
BILLING_CRON_SCHEDULE="0 0 * * *"
