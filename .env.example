# ==============================================================================
# SubFlow SaaS Subscription Management & Recurring Billing Platform
# Environment Configuration Template (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=subflow
POSTGRES_PASSWORD=subflow_secure_password_replace_in_prod
POSTGRES_DB=subflow_db
POSTGRES_PORT=5432

# Database Connection URL:
# - For host/local development outside Docker:
#   DATABASE_URL="postgresql://subflow:subflow_secure_password_replace_in_prod@localhost:5432/subflow_db?schema=public"
# - For Docker Compose (auto-configured in docker-compose.yml):
#   DATABASE_URL="postgresql://subflow:subflow_secure_password_replace_in_prod@postgres:5432/subflow_db?schema=public"
DATABASE_URL="postgresql://subflow:subflow_secure_password_replace_in_prod@localhost:5432/subflow_db?schema=public"

# ------------------------------------------------------------------------------
# 2. Fastify REST API Service
# ------------------------------------------------------------------------------
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# URL of the Web Frontend (used for CORS whitelist and redirect links)
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Next.js Web Frontend & URL Routing Distinction
# ------------------------------------------------------------------------------
# IMPORTANT ARCHITECTURAL DISTINCTION:
#
# INTERNAL_API_URL (Server-Side / Next.js rewrites):
#   Inside Docker, the Next.js node server proxies API requests to the Fastify
#   container using the Docker network service hostname: "http://api:4000".
#   Outside Docker, it defaults to "http://localhost:4000".
INTERNAL_API_URL=http://api:4000

# NEXT_PUBLIC_API_URL (Browser / Client-Side direct calls):
#   Must be accessible from the user's browser, e.g. "http://localhost:4000" or
#   a public domain name ("https://api.subflow.io"). NEVER use Docker container
#   hostnames like "http://api:4000" in browser-facing variables!
NEXT_PUBLIC_API_URL=http://localhost:4000

# ------------------------------------------------------------------------------
# 4. Authentication & Application Security
# ------------------------------------------------------------------------------
# Generate strong, cryptographically secure keys (min 32 characters) for production:
# e.g., openssl rand -hex 32
JWT_SECRET=subflow-dev-secret-jwt-token-key-2026-minimum-32-characters-required
COOKIE_SECRET=subflow-dev-secret-cookie-key-2026-minimum-32-characters-required

# ------------------------------------------------------------------------------
# 5. Autonomous Billing Background Worker
# ------------------------------------------------------------------------------
# Cron schedule for recurring subscription billing and automated invoice generation
# Default: Runs daily at midnight ("0 0 * * *"). For hourly checks, use "0 * * * *".
BILLING_CRON_SCHEDULE="0 0 * * *"
